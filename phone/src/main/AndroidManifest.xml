<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <queries>
        <package android:name="com.nhn.android.nmap" />
        <package android:name="net.daum.android.map" />
    </queries>
    <application android:allowBackup="false" android:fullBackupContent="false" android:label="VEMORING" android:name=".PhoneApplication"
        android:icon="@drawable/face_normal" android:roundIcon="@drawable/face_normal" android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <service android:name="com.vemoring.companion.MirrorBluetoothService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name="com.vemoring.companion.MirrorLinkRestoreReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name="com.vemoring.companion.PhoneWashAssistService" android:exported="false" android:foregroundServiceType="location" />
        <receiver android:name="com.vemoring.companion.CareCancelReceiver" android:exported="false" />
        <receiver android:name="com.vemoring.companion.CareDailyReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <!-- Launcher entries mirror the vehicle app: exactly one is enabled, matching the current mood. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" />
        <activity-alias android:name=".LauncherNormal" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_normal" android:roundIcon="@drawable/face_normal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherFuel" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_fuel" android:roundIcon="@drawable/face_fuel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherWash" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_wash" android:roundIcon="@drawable/face_wash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherOil" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_oil" android:roundIcon="@drawable/face_oil">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAngry" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_angry" android:roundIcon="@drawable/face_angry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherExhausted" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="VEMORING"
            android:icon="@drawable/face_exhausted" android:roundIcon="@drawable/face_exhausted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
